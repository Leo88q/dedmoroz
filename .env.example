# Токен бота MAX (платформа business.max.ru → Чат-боты → Настройки)
MAX_BOT_TOKEN=

# Базовый URL MAX Bot API.
# Для РФ рекомендуется https://platform-api2.max.ru (нужен сертификат Минцифры).
MAX_API_BASE=https://platform-api.max.ru

# Путь к SQLite-базе (для MVP). Для продакшена — PostgreSQL, см. README.
DATABASE_PATH=./dedmoroz.db

# MAX user_id диспетчеров через запятую (узнать свой id: команда /id в боте)
DISPATCHER_IDS=

# Секретный код для самоназначения диспетчером: /admin <код>
DISPATCHER_CODE=dedmoroz

# Заглушка ссылки на оплату; в проде заменяется на ЮKassa/Robokassa webhook
PAYMENT_BASE_URL=https://pay.example.ru/dedmoroz

# Сколько минут резервный артист имеет на ответ при форс-мажоре
BACKUP_RESPONSE_MINUTES=15

# Сколько минут артист имеет на подтверждение заказа
OFFER_RESPONSE_MINUTES=60

# Часовой пояс компании (для дат заказов и напоминаний)
BUSINESS_TZ=Europe/Moscow

# Таймаут long polling, секунд (0-90)
POLLING_TIMEOUT=30
